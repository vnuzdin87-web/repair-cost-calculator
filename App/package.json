{
  "name": "repair-cost-calculator",
  "version": "1.0.0",
  "description": "Калькулятор стоимости капитального ремонта квартиры",
  "main": "main.js",
  "author": "Calculator",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.repair.calculator",
    "productName": "Калькулятор стоимости ремонта",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "allowElevation": true,
      "language": "1049",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Калькулятор ремонта",
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
